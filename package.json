{
  "name": "qr-order",
  "version": "1.0.0",
  "description": "QR 테이블 오더 서비스 모노레포",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:server": "pnpm --filter @qr-order/server dev",
    "dev:web": "pnpm --filter @qr-order/web dev",
    "dev:admin": "pnpm --filter @qr-order/admin dev",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:db:seed": "pnpm --filter @qr-order/server seed",
    "docker:rebuild": "docker-compose down && docker-compose build server web admin && docker-compose up -d",
    "docker:restart": "docker-compose restart",
    "docker:restart:app": "docker-compose restart server web admin",
    "docker:restart:server": "docker-compose restart server",
    "docker:restart:web": "docker-compose restart web",
    "docker:restart:admin": "docker-compose restart admin",
    "docker:restart:nginx": "docker-compose restart nginx",
    "docker:restart:redis": "docker-compose restart redis",
    "docker:restart:postgres": "docker-compose restart postgres"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
